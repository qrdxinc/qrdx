  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc --project tsconfig.build.json --emitDeclarationOnly && node scripts/esm-types.mjs",
    "build:inplace": "tsup && tsc --project tsconfig.build.json --emitDeclarationOnly && node scripts/esm-types.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "readme": "node scripts/readme-catalogue.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:react": "node scripts/react-compat.mjs",
    "check:legacy": "node scripts/legacy-compat.mjs",
    "prepublishOnly": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('bun/')){console.error('Publish through the Publish workflow, or with bun publish, which replaces workspace ranges with real versions.');process.exit(1)}\" && bun run build && bun run test && node scripts/readme-catalogue.mjs --check"
