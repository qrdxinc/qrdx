{
  "name": "qrdx",
  "version": "0.0.67",
  "description": "Customizable QR code generator for React and plain JavaScript: SVG and canvas rendering, dot and eye patterns, gradients, logos, frames, Logo QR and Image QR art, PNG/JPG/WebP/SVG/PDF/EPS/TIFF export, a scan score and QR scanning.",
